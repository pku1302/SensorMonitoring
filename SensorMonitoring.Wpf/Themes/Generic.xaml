<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SensorMonitoring.Wpf.Controls"
                    xmlns:models="clr-namespace:SensorMonitoring.Contracts;assembly=SensorMonitoring.Contracts">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Styles/Themes.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <Style TargetType="{x:Type local:StatusBadge}">
        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="{x:Type local:StatusBadge}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="Dot"
                                 Width="6"
                                 Height="6"
                                 Margin="0,0,5,0"
                                 VerticalAlignment="Center"/>

                        <TextBlock x:Name="Label"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <ControlTemplate.Triggers>

                        <Trigger Property="Status"
                                 Value="{x:Static models:SensorStatus.Normal}">
                            <Setter TargetName="Dot"
                                    Property="Fill"
                                    Value="{StaticResource NormalBrush}"/>

                            <Setter TargetName="Label"
                                    Property="Text"
                                    Value="정상"/>
                            
                            <Setter TargetName="Label"
                                    Property="Foreground"
                                    Value="{StaticResource NormalBrush}"/>
                        </Trigger>

                        <Trigger Property="Status"
                                 Value="{x:Static models:SensorStatus.Warning}">
                            <Setter TargetName="Dot"
                                    Property="Fill"
                                    Value="{StaticResource WarningBrush}"/>

                            <Setter TargetName="Label"
                                    Property="Text"
                                    Value="주의"/>

                            <Setter TargetName="Label"
                                    Property="Foreground"
                                    Value="{StaticResource WarningBrush}"/>
                        </Trigger>

                        <Trigger Property="Status"
                                 Value="{x:Static models:SensorStatus.Danger}">
                            <Setter TargetName="Dot"
                                    Property="Fill"
                                    Value="{StaticResource DangerBrush}"/>

                            <Setter TargetName="Label"
                                    Property="Text"
                                    Value="위험"/>

                            <Setter TargetName="Label"
                                    Property="Foreground"
                                    Value="{StaticResource DangerBrush}"/>
                        </Trigger>

                        <Trigger Property="Status"
                                 Value="{x:Static models:SensorStatus.Offline}">
                            <Setter TargetName="Dot"
                                    Property="Fill"
                                    Value="{StaticResource MutedBrush}"/>

                            <Setter TargetName="Label"
                                    Property="Text"
                                    Value="수신 끊김"/>

                            <Setter TargetName="Label"
                                    Property="Foreground"
                                    Value="{StaticResource MutedBrush}"/>
                        </Trigger>


                    </ControlTemplate.Triggers>
                    
                </ControlTemplate>
                
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>