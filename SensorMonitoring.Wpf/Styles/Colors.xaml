<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush
        x:Key="SidebarBackgroundBrush"
        Color="#20252E"/>

    <SolidColorBrush
        x:Key="SidebarHoverBrush"
        Color="#313844"/>

    <SolidColorBrush
        x:Key="PrimaryTextBrush"
        Color="#161B22"/>

    <SolidColorBrush
        x:Key="SecondaryTextBrush"
        Color="#687182"/>

    <SolidColorBrush
        x:Key="SidebarMutedTextBrush"
        Color="#7F8998"/>

    <SolidColorBrush
        x:Key="SidebarVersionTextBrush"
        Color="#606977"/>

    <SolidColorBrush
        x:Key="SidebarSeparatorBrush"
        Color="#353C47"/>

    <SolidColorBrush
        x:Key="SurfaceLightBrush"
        Color="#F6F8FA"/>

    <SolidColorBrush
        x:Key="BorderBrush"
        Color="#E5E7EB"/>

    <SolidColorBrush
        x:Key="SuccessBrush"
        Color="#2EAD65"/>

    <SolidColorBrush
    x:Key="WarningBrush"
    Color="#E6A23C"/>

    <SolidColorBrush
    x:Key="DangerBrush"
    Color="#DC3545"/>
</ResourceDictionary>