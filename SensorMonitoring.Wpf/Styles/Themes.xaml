<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PageBrush" Color="#F3F5F8"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#263247"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#657389"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E1E6EE"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2466DC"/>
    <SolidColorBrush x:Key="NormalBrush" Color="#187450"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#936016"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C23C45"/>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    <!-- Status는 Normal / Warning / Danger / Offline. 상태별 색상은 여기에서 관리. -->
    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Normal">
                <Setter Property="Foreground" Value="{StaticResource NormalBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Warning">
                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Danger">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SensorListItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,10,10"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Frame" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="2" CornerRadius="6">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="#F1F6FF"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>