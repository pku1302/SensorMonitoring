<UserControl x:Class="SensorMonitoring.Wpf.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SensorMonitoring.Wpf.Views"
             mc:Ignorable="d" >
    <Border Style="{StaticResource SidebarContainerStyle}">

        <Grid Margin="14">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Text="MENU"
                Style="{StaticResource SidebarSectionTitleStyle}"/>

            <StackPanel Grid.Row="1">

                <Button
                    Content="Dashboard"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="Dashboard"
                    Style="{StaticResource SidebarButtonStyle}"/>

                <Button
                    Content="Sensors"
                    Command="{Binding NavigateCommand}"
                    Style="{StaticResource SidebarButtonStyle}"/>

                <Button
                    Content="Alarms"
                    Command="{Binding NavigateCommand}"
                    Style="{StaticResource SidebarButtonStyle}"/>

                <Button
                    Content="Settings"
                    Command="{Binding NavigateCommand}"
                    Style="{StaticResource SidebarButtonStyle}"/>

            </StackPanel>

            <StackPanel
                Grid.Row="2"
                Margin="12,0,12,10">

                <Border
                    Style="{StaticResource SidebarSeparatorStyle}"/>

                <TextBlock
                    Text="Sensor Monitoring"
                    Style="{StaticResource SidebarFooterTextStyle}"/>

                <TextBlock
                    Text="v1.0.0"
                    Style="{StaticResource SidebarVersionTextStyle}"/>

            </StackPanel>

        </Grid>

    </Border>
</UserControl>
