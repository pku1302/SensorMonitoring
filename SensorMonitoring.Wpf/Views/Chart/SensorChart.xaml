<UserControl x:Class="SensorMonitoring.Wpf.Views.Chart.SensorChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SensorMonitoring.Wpf.Views.Chart"
             mc:Ignorable="d">
    <Border Style="{StaticResource Panel}"
            Height="230"
            Margin="0,0,0,16">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="45"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <!-- 제목 -->
                <RowDefinition Height="Auto"/>
                <!-- 차트 -->
                <RowDefinition Height="120"/>
                <!-- X축 라벨 -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 제목 -->
            <Grid Grid.Row="0"
                  Grid.ColumnSpan="2"
                  Margin="0,0,0,12">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 왼쪽: 센서 제목 -->
                <TextBlock Grid.Column="0"
                           Text="{Binding Name}"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal"
                            Grid.Column="1"
                            Visibility="{Binding ControlVisibility}">

                    <!-- 오른쪽: 일시정지 버튼 -->
                    <Button Width="32"
                            Height="32"
                            Grid.Column="1"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding PauseCommand}">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border x:Name="ButtonBorder"
                                    Background="Transparent"
                                    CornerRadius="6">
                                    <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                                </Border>

                                <ControlTemplate.Triggers>

                                    <!-- 마우스 호버 -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBorder"
                                            Property="Background"
                                            Value="#F3F5F8"/>
                                    </Trigger>

                                    <!-- 클릭 중 -->
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ButtonBorder"
                                            Property="Background"
                                            Value="#E1E6EE"/>
                                    </Trigger>

                                    <!-- 비활성화 -->
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="ButtonBorder"
                                                Property="Opacity"
                                                Value="0.3"/>
                                    </Trigger>

                                    <DataTrigger Binding="{Binding IsPaused}"
                                                 Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>
                        </Button.Template>

                        <Path Width="16"
                          Height="16"
                          Fill="#263247"
                          Stretch="Uniform"
                          Data="M 4,2 L 8,2 L 8,18 L 4,18 Z
                                M 12,2 L 16,2 L 16,18 L 12,18 Z"/>
                    </Button>

                    <!-- 오른쪽: 일시정지 버튼 -->
                    <Button Command="{Binding ReturnToLiveCommand}"
                            IsEnabled="{Binding IsPaused}"
                            Width="32"
                            Height="32"
                            Margin="8,0,0,0"
                            Foreground="White"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="최신 데이터로 복귀">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border x:Name="ButtonBorder"
                                    Background="Transparent"
                                    CornerRadius="6">
                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>

                                <ControlTemplate.Triggers>

                                    <!-- 마우스 호버 -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBorder"
                                                Property="Background"
                                                Value="#F3F5F8"/>
                                    </Trigger>

                                    <!-- 클릭 중 -->
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ButtonBorder"
                                                Property="Background"
                                                Value="#E1E6EE"/>
                                    </Trigger>

                                    <!-- 비활성화 -->
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="ButtonBorder"
                                                Property="Opacity"
                                                Value="0.3"/>
                                    </Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>
                        </Button.Template>

                        <!-- 재생 아이콘 -->
                        <Path Width="16"
                              Height="16"
                              Fill="#263247"
                              Stretch="Uniform"
                              Data="M 5,2 L 17,10 L 5,18 Z"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Y축 라벨 -->
            <Canvas x:Name="YAxisCanvas"
                  Grid.Row="1"
                  Grid.Column="0"
                  Margin="0,0,8,0"
                  IsHitTestVisible="False">

                <TextBlock x:Name="MaxLabel"
                           Foreground="Gray"/>

                <TextBlock x:Name="MidLabel"
                           Foreground="Gray"/>

                <TextBlock x:Name="MinLabel"
                           Foreground="Gray"/>

                <TextBlock x:Name="DangerLabel"
                           Foreground="#D99090"/>
            </Canvas>

            <Canvas x:Name="ChartCanvas"
                    Grid.Row="1"
                    Grid.Column="1"
                    Background="Transparent"
                    SizeChanged="ChartCanvas_SizeChanged"
                    MouseLeftButtonDown="ChartCanvas_MouseLeftButtonDown"
                    MouseLeftButtonUp="ChartCanvas_MouseLeftButtonUp"
                    MouseMove="ChartCanvas_MouseMove"
                    MouseLeave="ChartCanvas_MouseLeave"
                    MouseWheel="ChartCanvas_MouseWheel"
                    LostMouseCapture="ChartCanvas_LostMouseCapture">

                <!-- 수평 눈금선 -->
                <Line x:Name="MaxGridLine"
                      Stroke="#666666"
                      StrokeThickness="1"
                      StrokeDashArray="4,4"/>

                <Line x:Name="MidGridLine"
                      Stroke="#666666"
                      StrokeThickness="1"
                      StrokeDashArray="4,4"/>

                <Line x:Name="MinGridLine"
                      Stroke="#666666"
                      StrokeDashArray="4,4"
                      StrokeThickness="1"/>

                <!-- 위험 기준선 -->
                <Line x:Name="DangerGridLine"
                      Stroke="#C75B5B"
                      StrokeThickness="1"
                      StrokeDashArray="4,4"
                      IsHitTestVisible="False"/>

                <!-- 마우스 호버 세로선 -->
                <Line x:Name="HoverLine"
                      Stroke="#AAAAAA"
                      StrokeThickness="1"
                      StrokeDashArray="4,4"
                      IsHitTestVisible="False"
                      Visibility="Collapsed"/>

                <Canvas x:Name="HistoryLineLayer"
                        IsHitTestVisible="False"/>

                <Canvas x:Name="HistoryRangeLayer"
                        IsHitTestVisible="False"/>

                <!-- 차트 -->
                <Polyline x:Name="ChartLine"
                          Stroke="{StaticResource NormalBrush}"
                          StrokeThickness="2"
                          StrokeLineJoin="Round"/>

                <!-- 위험 영역 그래프 -->
                <Polyline x:Name="DangerChartLine"
                          Stroke="{StaticResource DangerBrush}"
                          StrokeThickness="2"
                          StrokeLineJoin="Round"
                          IsHitTestVisible="False"/>

                <!-- 선택된 데이터 포인트 -->
                <Ellipse x:Name="HoverPoint"
                         Width="9"
                         Height="9"
                         Fill="{StaticResource NormalBrush}"
                         Stroke="White"
                         StrokeThickness="1.5"
                         IsHitTestVisible="False"
                         Visibility="Collapsed"/>

                <!-- 호버 툴팁 -->
                <Border x:Name="HoverTooltip"
                        Background="#2C3A55"
                        BorderBrush="#4A5975"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">

                    <StackPanel>
                        <!-- 시간 + 원 -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,4">
                            <Ellipse x:Name="TooltipStatusDot"
                                     Width="8"
                                     Height="8"
                                     Fill="{StaticResource NormalBrush}"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center"/>

                            <TextBlock x:Name="HoverTimeText"
                                       Foreground="#BBBBBB"
                                       FontSize="11"/>
                        </StackPanel>

                        <TextBlock x:Name="HoverValueText"
                                   Foreground="White"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>

                        <!-- 히스토리 전용 -->
                        <StackPanel x:Name="HoverRangePanel"
                            Margin="0,6,0,0"
                            Visibility="Collapsed">

                            <Border Height="1"
                                    Background="#44516A"/>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 최댓값 -->
                                <TextBlock Text="최댓값:"
                                           Grid.Row="0"
                                           Grid.Column="0"
                                           Foreground="#E6A0A0"
                                           FontSize="12"
                                           Margin="0,8,0,0"/>

                                <TextBlock x:Name="HoverMaxText"
                                           Grid.Row="0"
                                           Grid.Column="1"
                                           Foreground="#E6A0A0"
                                           FontSize="12"
                                           Margin="16,8,0,0"/>

                                <!-- 최솟값 -->
                                <TextBlock Text="최솟값:"
                                           Grid.Row="1"
                                           Grid.Column="0"
                                           Foreground="#8FC5E8"
                                           FontSize="12"/>

                                <TextBlock x:Name="HoverMinText"
                                           Grid.Row="1"
                                           Grid.Column="1"
                                           Foreground="#8FC5E8"
                                           FontSize="12"
                                           Margin="16,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Canvas>
            <!-- X축 라벨 -->
            <Canvas x:Name="XAxisCanvas"
                    Grid.Row="2"
                    Grid.Column="1"
                    Height="20"
                    Margin="0,8,0,0"
                    ClipToBounds="True">

                <!-- 실시간 X축 라벨 -->
                <Canvas x:Name="RealtimeXAxisLayer"
                        Width="{Binding ActualWidth, ElementName=XAxisCanvas}"
                        Height="24"
                        IsHitTestVisible="False"/>

                <!-- 히스토리 차트용 동적 라벨 -->
                <Canvas x:Name="HistoryXAxisLayer"
                        Width="{Binding ActualWidth, ElementName=XAxisCanvas}"
                        Height="24"
                        IsHitTestVisible="False"/>
            </Canvas>
        </Grid>
    </Border>

</UserControl>
