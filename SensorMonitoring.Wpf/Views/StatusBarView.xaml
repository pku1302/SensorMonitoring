<UserControl x:Class="SensorMonitoring.Wpf.Views.StatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SensorMonitoring.Wpf.Views"
             mc:Ignorable="d" >
    
    <Border Style="{StaticResource TopBarContainerStyle}">

        <Grid Margin="10,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 왼쪽 -->
            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                <TextBlock
                    Text="Sensor Monitoring"
                    Style="{StaticResource AppTitleStyle}"/>

                <Border
                    Style="{StaticResource TopBarVerticalSeparatorStyle}"/>

                <TextBlock
                    Text="Dashboard"
                    Style="{StaticResource TopBarSectionTextStyle}"/>

            </StackPanel>

            <!-- 오른쪽 -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                <Border
                    Style="{StaticResource StatusChipStyle}"
                    Margin="0,0,10,0">

                    <StackPanel Orientation="Horizontal">

                        <Ellipse
                            Width="8"
                            Height="8"
                            Margin="0,0,7,0"
                            >
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">

                                    <Setter
                Property="Fill"
                Value="{StaticResource WarningBrush}"/>

                                    <Style.Triggers>

                                        <DataTrigger
                    Binding="{Binding ConnectionStatus}"
                    Value="Connected">

                                            <Setter
                        Property="Fill"
                        Value="{StaticResource SuccessBrush}"/>

                                        </DataTrigger>

                                        <DataTrigger
                    Binding="{Binding ConnectionStatus}"
                    Value="Disconnected">

                                            <Setter
                        Property="Fill"
                        Value="{StaticResource DangerBrush}"/>

                                        </DataTrigger>

                                        <DataTrigger
                    Binding="{Binding ConnectionStatus}"
                    Value="Reconnecting...">

                                            <Setter
                        Property="Fill"
                        Value="{StaticResource WarningBrush}"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>
                            </Ellipse.Style>

                        </Ellipse>

                        <TextBlock
                            Text="SignalR"
                            Style="{StaticResource StatusLabelStyle}"/>

                        <TextBlock
                            Text="{Binding ConnectionStatus}">

                            <TextBlock.Style>

                                <Style
            TargetType="TextBlock"
            BasedOn="{StaticResource StatusValueStyle}">

                                    <Setter
                Property="Foreground"
                Value="{StaticResource WarningBrush}"/>

                                    <Style.Triggers>

                                        <DataTrigger
                    Binding="{Binding ConnectionStatus}"
                    Value="Connected">

                                            <Setter
                        Property="Foreground"
                        Value="{StaticResource SuccessBrush}"/>

                                        </DataTrigger>

                                        <DataTrigger
                    Binding="{Binding ConnectionStatus}"
                    Value="Disconnected">

                                            <Setter
                        Property="Foreground"
                        Value="{StaticResource DangerBrush}"/>

                                        </DataTrigger>

                                        <DataTrigger
                    Binding="{Binding ConnectionStatus}"
                    Value="Reconnecting...">

                                            <Setter
                        Property="Foreground"
                        Value="{StaticResource WarningBrush}"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                        </TextBlock>

                    </StackPanel>

                </Border>

                <Border
                    Style="{StaticResource StatusChipStyle}"
                    Margin="0,0,14,0">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock
                            Text="Sensors"
                            Style="{StaticResource StatusLabelStyle}"/>

                        <TextBlock
                            Text="{Binding SensorCount}"
                            Style="{StaticResource StatusValueStyle}"/>

                    </StackPanel>

                </Border>

                <TextBlock
                    Text="{Binding CurrentTime}"
                    Style="{StaticResource CurrentTimeStyle}"/>

            </StackPanel>

        </Grid>

    </Border>
</UserControl>
