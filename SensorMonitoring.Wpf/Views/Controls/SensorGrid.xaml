<UserControl x:Class="SensorMonitoring.Wpf.Views.Controls.SensorGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SensorMonitoring.Wpf.Views.Controls"
             xmlns:controls="clr-namespace:SensorMonitoring.Wpf.Views.Controls"
             mc:Ignorable="d" >
    <StackPanel Margin="0,0,0,10">
        <DockPanel Margin="0,0,0,12">
            <TextBlock Text="센서 현황" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="센서를 선택하면 추이 표시" HorizontalAlignment="Right" Style="{StaticResource MutedText}"/>
        </DockPanel>
        <ListBox ItemsSource="{Binding Sensors}" SelectedItem="{Binding SelectedSensor, Mode=TwoWay}"
            SelectionMode="Single" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,-10,0"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
            ItemContainerStyle="{StaticResource SensorListItem}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="5"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <controls:SensorCard/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>
