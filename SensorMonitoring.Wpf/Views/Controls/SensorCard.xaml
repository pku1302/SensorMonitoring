<UserControl x:Class="SensorMonitoring.Wpf.Views.Controls.SensorCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SensorMonitoring.Wpf.Views.Controls"
             xmlns:controls="clr-namespace:SensorMonitoring.Wpf.Controls"
             mc:Ignorable="d">
    <StackPanel Margin="12">
        <TextBlock Text="{Binding DeviceId}" Style="{StaticResource MutedText}"/>
        <TextBlock Text="{Binding Temperature}" FontSize="21" FontWeight="SemiBold" Margin="0,8"/>
        <controls:StatusBadge Status="{Binding Status}" />
    </StackPanel>
</UserControl>
