<UserControl x:Class="SensorMonitoring.Wpf.Views.Controls.TrendChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SensorMonitoring.Wpf.Views.Controls"
             mc:Ignorable="d">
    <!-- 예제용 고정 범위 차트: 0~100 °C, 31개 샘플 -->
    <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
        <StackPanel>
            <DockPanel Margin="0,0,0,12">
                <TextBlock Text="{Binding SelectedSensor.Id, StringFormat={}{0} · 온도 추이}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="최근 1분 · 예시 데이터" HorizontalAlignment="Right" Style="{StaticResource MutedText}"/>
            </DockPanel>
            <Grid Height="210">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="26"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="°C" Style="{StaticResource MutedText}"/>
                <Grid Grid.Row="1">
                    <TextBlock Text="100" VerticalAlignment="Top" Style="{StaticResource MutedText}"/>
                    <TextBlock Text="50" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                    <TextBlock Text="0" VerticalAlignment="Bottom" Style="{StaticResource MutedText}"/>
                </Grid>
                <Grid Grid.Row="1" Grid.Column="1" ClipToBounds="True">
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1"/>
                    <Border Height="1" VerticalAlignment="Center" Background="{StaticResource LineBrush}"/>
                    <Viewbox Stretch="Fill" Visibility="{Binding SelectedSensor.HasData, Converter={StaticResource BoolToVisibility}}">
                        <Canvas Width="600" Height="160">
                            <Polyline Points="{Binding SelectedSensor.TrendPoints}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="수신 끊김 · 현재값 없음" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding SelectedSensor.IsOffline, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource MutedText}"/>
                </Grid>
                <Grid Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                    <TextBlock Text="09:41:00" HorizontalAlignment="Left" Style="{StaticResource MutedText}"/>
                    <TextBlock Text="09:41:30" HorizontalAlignment="Center" Style="{StaticResource MutedText}"/>
                    <TextBlock Text="09:42:00" HorizontalAlignment="Right" Style="{StaticResource MutedText}"/>
                </Grid>
            </Grid>
            <TextBlock Text="{Binding SelectedSensor.DetailText}" Margin="0,12,0,0" TextWrapping="Wrap" Style="{StaticResource MutedText}"/>
        </StackPanel>
    </Border>
</UserControl>
