<UserControl x:Class="SensorMonitoring.Wpf.Views.Controls.SummaryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SensorMonitoring.Wpf.Views.Controls"
             mc:Ignorable="d">
    <Border Style="{StaticResource Panel}" Margin="0,0,10,0">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource MutedText}"/>
            <TextBlock Text="{Binding Count}" Style="{StaticResource StatusText}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
