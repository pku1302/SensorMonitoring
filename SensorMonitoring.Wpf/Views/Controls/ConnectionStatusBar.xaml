<UserControl x:Class="SensorMonitoring.Wpf.Views.Controls.ConnectionStatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SensorMonitoring.Wpf.Views.Controls"
             mc:Ignorable="d">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,10">
        <DockPanel>
            <TextBlock Text="{Binding StorageStatusText}" Style="{StaticResource MutedText}"/>
            <TextBlock Text="{Binding LastReceivedText}" HorizontalAlignment="Right" Style="{StaticResource MutedText}"/>
        </DockPanel>
    </Border>
</UserControl>
