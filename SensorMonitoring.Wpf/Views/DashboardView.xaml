<UserControl x:Class="SensorMonitoring.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SensorMonitoring.Wpf.Views"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d" >
    <Grid >

        <Grid.ColumnDefinitions>

            <!-- 왼쪽 센서 목록 -->
            <ColumnDefinition Width="3*"/>

            <!-- 가운데 간격 -->
            <ColumnDefinition Width="20"/>

            <!-- 오른쪽 차트 -->
            <ColumnDefinition Width="2*"/>

        </Grid.ColumnDefinitions>


        <!-- ===================================== -->
        <!-- 왼쪽 : 센서 목록 -->
        <!-- ===================================== -->

        <DataGrid
        Grid.Column="0"
        ItemsSource="{Binding Sensors}"
        SelectedItem="{Binding SelectedSensor}"
        AutoGenerateColumns="False"
        IsReadOnly="True"
        CanUserAddRows="False"
        CanUserDeleteRows="False"
        SelectionMode="Single"
        SelectionUnit="FullRow"
        HeadersVisibility="Column"
        GridLinesVisibility="Horizontal"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Auto">

            <DataGrid.RowStyle>

                <Style TargetType="DataGridRow">

                    <Style.Triggers>

                        <DataTrigger
                        Binding="{Binding Status}"
                        Value="Offline">

                            <Setter
                            Property="Opacity"
                            Value="0.5"/>

                        </DataTrigger>

                        <DataTrigger
                        Binding="{Binding Status}"
                        Value="High Temperature">

                            <Setter
                            Property="FontWeight"
                            Value="Bold"/>

                        </DataTrigger>

                        <DataTrigger
                        Binding="{Binding Status}"
                        Value="High Humidity">

                            <Setter
                            Property="FontWeight"
                            Value="Bold"/>

                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </DataGrid.RowStyle>


            <DataGrid.Columns>

                <DataGridTextColumn
                Header="Device ID"
                Binding="{Binding DeviceId}"
                Width="1.2*"/>

                <DataGridTextColumn
                Header="Connection"
                Binding="{Binding ConnectionText}"
                Width="1.1*"/>

                <DataGridTextColumn
                Header="Temperature"
                Binding="{Binding Temperature,
                                  StringFormat={}{0:F2} °C}"
                Width="1.2*"/>

                <DataGridTextColumn
                Header="Humidity"
                Binding="{Binding Humidity,
                                  StringFormat={}{0:F2} %}"
                Width="1.1*"/>

                <DataGridTextColumn
                Header="Total Production"
                Binding="{Binding TotalProduction}"
                Width="*"/>

                <DataGridTextColumn
                Header="Status"
                Binding="{Binding Status}"
                Width="1.2*"/>

                <DataGridTextColumn
                Header="Last Updated"
                Binding="{Binding LocalTimestamp,
                                  StringFormat={}{0:HH:mm:ss}}"
                Width="1.2*"/>

            </DataGrid.Columns>

        </DataGrid>


        <!-- ===================================== -->
        <!-- 오른쪽 : 선택 센서 + 차트 -->
        <!-- ===================================== -->

        <Grid Grid.Column="2">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="10"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <!-- 선택 센서 정보 -->

            <StackPanel
            Grid.Row="0"
            Margin="0,0,0,15">

                <TextBlock
                Text="{Binding SelectedSensor.DeviceId,
                               TargetNullValue=Select a sensor}"
                FontSize="24"
                FontWeight="Bold"/>

                <TextBlock
                Text="Real-time sensor data"
                Margin="0,4,0,0"
                Opacity="0.6"/>

            </StackPanel>


            <!-- 온도 차트 -->

            <GroupBox
            Grid.Row="1"
            Header="Temperature">

                <Grid Margin="10">

                    <lvc:CartesianChart
                    Series="{Binding TemperatureSeries}"/>

                </Grid>

            </GroupBox>


            <!-- 습도 차트 -->

            <GroupBox
            Grid.Row="3"
            Header="Humidity">

                <Grid Margin="10">

                    <lvc:CartesianChart
                    Series="{Binding HumiditySeries}"/>

                </Grid>

            </GroupBox>

        </Grid>

    </Grid>
</UserControl>
