<Application x:Class="SensorMonitoring.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SensorMonitoring.Wpf">
    <Application.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <!-- 색상 리소스를 가장 먼저 -->
                <ResourceDictionary
                    Source="Styles/Colors.xaml"/>

                <ResourceDictionary
                    Source="Styles/ButtonStyles.xaml"/>

                <ResourceDictionary
                    Source="Styles/TextStyles.xaml"/>

                <ResourceDictionary
                    Source="Styles/CommonStyles.xaml"/>

                <ResourceDictionary 
                    Source="/Styles/Themes.xaml"/>

            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
        
    </Application.Resources>
</Application>
